set lotes; #quais lotes
set maquinas; #quais maquinas
set jobs; #quais jobs
#
param L{jobs, lotes} >= 0; #composicao de cada lote
param tempos{lotes} >= 0; #tempos de processamento de cada lote
param pesos{lotes} >= 0; #pesos em kg de cada lote
param capacidade{maquinas} >= 0; #capacidade (em kg)  de cada máquina
#
###Variaveis###
var x {i in lotes, m in maquinas} binary; #em qual lote o job estah
var Cmax >= 0;  #tamanho do maior lote na maquina m
#
###Funcao objetivo###
minimize c_max: Cmax;
#
###Restricoes###
subject to traba_unic{j in jobs}: sum {i in lotes, m in maquinas} L[j,i]*x[i, m] = 1;
subject to limit_peso{i in lotes, m in maquinas}: pesos[i]*x[i,m] <= capacidade[m];
subject to makes_spam{m in maquinas}: sum{i in lotes} tempos[i]*x[i,m] <= Cmax;
#
###dados###
data;
#
set lotes := L1	L2	L3	L4	L5	L6	L7	L8	L9	L10	L11	L12	L13	L14	L15	L16	L17	L18	L19	L20	L21	L22	L23	L24	L25	L26	L27	L28	L29	L30	L31	L32	L33	L34	L35	L36	L37	L38	L39	L40	L41	L42	L43	L44	L45	L46	L47	L48	L49	L50	L51	L52	L53	L54	L55	L56	L57	L58	L59	L60	L61	L62	L63	L64	L65	L66	L67	L68	L69	L70	L71	L72	L73	L74	L75	L76	L77	L78	L79	L80	L81	L82	L83	L84	L85	L86	L87	L88	L89	L90	L91	L92	L93	L94	L95	L96	L97	L98	L99	L100	L101	L102	L103	L104	L105	L106	L107	L108	L109	L110	L111	L112	L113	L114	L115	L116	L117	L118	L119	L120	L121	L122	L123	L124	L125;
